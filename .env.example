# ==============================================================================
# Transit Delay System - Environment Configuration Template
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_DB=transit_db
POSTGRES_USER=transit_user
POSTGRES_PASSWORD=transit_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JupyterLab Configuration
JUPYTER_PORT=8888
JUPYTER_TOKEN=transit-dev-token

# Data Storage Paths (relative or container paths)
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_FEATURES_DIR=./data/features

# Ingestion / API Settings (Optional / Future)
TRANSIT_API_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=

